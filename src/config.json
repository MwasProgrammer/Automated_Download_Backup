{
    "project_name": "Automated Download Backup",
    "version": "1.0.0",
    "description": "A project to automate the backup of downloaded files from the internal local drive C to the external backup drive.",
    "source_settings": {
        "target_directory_name": "/home/mwas-programmer/Downloads",
        "use_envs_vars": true,
        "sandbox_mode": false,  
        "target_directory_path":"/home/mwas-programmer/ADB-CLONE/Automated_Download_Backup/tests/sandbox/downloads"
    },

    "BACKUP_BATCH": 5,

    "backup_target": {
        "volume_label": "SELECT",
        "backup_directory_name": "/media/mwas-programmer/hDD/ubuntu-backup",
        "backup_directory_path": "tests/sandbox/backup",
        "is_ntfs": true,
        "backup_folders": {
            "Documents":[".docx", ".pdf", ".txt", ".odt", ".xlsx", ".pptx"],
            "Images": [".jpg", ".jpeg", ".png", ".gif"],
            "Videos": [".mp4", ".avi", ".mkv"],
            "Archives": [".zip", ".rar", ".7z"],
            "Executables": [".exe", ".msi", ".deb", ".rpm"],
            "Audio": [".mp3", ".wav", ".flac"],
            "Others": []
        }


    },

    "safety_measures": {
        "forbidden_extensions": [".crdownload", ".tmp", ".part"],
        "atomic_suffix": ".transferring"
    }

}